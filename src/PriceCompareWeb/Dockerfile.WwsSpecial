# syntax=docker/dockerfile:1.6

# ===============================

# Wws Special Job Lambda (.NET 8 + Playwright)

# Base: Amazon Linux 2023

# ===============================

FROM public.ecr.aws/lambda/dotnet:8 AS base

ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright

RUN --mount=type=cache,target=/var/cache/dnf set -eux; \
    echo "Installing system dependencies (no full upgrade)..."; \
    dnf -y install --setopt=install_weak_deps=0 tar gzip xz zip wget which shadow-utils nss \
        atk at-spi2-atk cups-libs gtk3 \
        libXcomposite libXcursor libXdamage libXext libXi libXtst pango \
        alsa-lib cairo gdk-pixbuf2 libdrm libgbm freetype glib2 \
        ca-certificates; \
    dnf clean all

# ===============================

# Build .NET app

# ===============================

FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
WORKDIR /src

ENV DOTNET_CLI_HOME=/tmp \
    NUGET_PACKAGES=/root/.nuget/packages \
    TMPDIR=/tmp \
    PLAYWRIGHT_BROWSERS_PATH=/ms-playwright \
    DOTNET_NOLOGO=1 \
    DOTNET_SKIP_FIRST_TIME_EXPERIENCE=1 \
    PATH=/root/.dotnet/tools:/tmp/.dotnet/tools:$PATH

RUN mkdir -p /ms-playwright

COPY PriceCompareSolution.sln ./
COPY src/PriceCompareCore/PriceCompareCore.csproj src/PriceCompareCore/
COPY src/PriceCompareData/PriceCompareData.csproj src/PriceCompareData/
COPY src/PriceCompareWeb/PriceCompareWeb.csproj src/PriceCompareWeb/

# Restore only the web project
ARG NUGET_SOURCE=https://api.nuget.org/v3/index.json
RUN --mount=type=cache,target=/root/.nuget/packages \
    --mount=type=cache,target=/root/.local/share/NuGet/v3-cache \
    dotnet restore src/PriceCompareWeb/PriceCompareWeb.csproj \
        --verbosity minimal \
        --source $NUGET_SOURCE

COPY . .
WORKDIR /src/src/PriceCompareWeb

# Restore, publish, then install Playwright browsers via global CLI (no version pin)
RUN --mount=type=cache,target=/root/.nuget/packages \
    --mount=type=cache,target=/root/.local/share/NuGet/v3-cache \
    dotnet restore --verbosity minimal --source $NUGET_SOURCE \
    && dotnet publish -c Release -o /app/publish --no-restore --verbosity minimal \
        /p:UseAppHost=false \
    && dotnet tool install --global Microsoft.Playwright.CLI --add-source $NUGET_SOURCE \
    && playwright install chromium

# Pre-generate .playwright for .NET driver in the publish output with correct exec perms
WORKDIR /app/publish
RUN set -eux; \
    chmod +x ./playwright.sh; \
    ./playwright.sh install chromium; \
    if [ -d ./.playwright ]; then \
      find ./.playwright -maxdepth 3 -type f -name node -exec chmod 755 {} +; \
    fi


# ===============================

# Runtime

# ===============================

FROM base AS final
WORKDIR /var/task
COPY --from=build /app/publish .
COPY --from=build /ms-playwright /ms-playwright

# Ensure Playwright driver (Node binary) is executable without heavy recursion
RUN if [ -d /var/task/.playwright ]; then \
      find /var/task/.playwright -maxdepth 3 -type f -name node -exec chmod 755 {} +; \
    fi || true

CMD ["PriceCompareWeb::PriceCompareWeb.JobsLambda.WwsRefreshSpecialLambda::Handler"]
