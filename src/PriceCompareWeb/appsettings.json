{
  "ConnectionStrings": {
    "DefaultConnection": "Host=__HOST__;Port=5432;Database=__DB__;Username=__USER__;Password=__PASSWORD__;SSL Mode=Require;Trust Server Certificate=true"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "JwtSettings": {
  "Secret": "__REPLACE_ME__",
  "ExpireMinutes": 60
  },
  
  "Aws": {
    "Region": "ap-southeast-2",
    "ReceiptBucket": "pricecompare-receipts-dev"
  },
  "Scraping": {
    "EnableQuartz": true
  },
  "ScrapeExport": {
    "Enabled": false,
    "ExportDir": "exports",
    "BatchSize": 500
  },
  "Rekognition": {
    "MinConfidence": 60
  },

  "Email": {
  "Host": "smtp.qq.com",
  "Port": 587,
  "UseSsl": false,
  "Username": "your@email.com",
  "Password": "__REPLACE_ME__",
  "FromEmail": "your@email.com",
  "FromName": "PriceCompare"
  },

  "FavoriteAlerts": {
    "BaseUrl": "http://pricecompare-frontend-dev.s3-website-ap-southeast-2.amazonaws.com",
    "FavoritesPath": "/"
  },

  "OpenRouter": {
  "ApiKey": "",
  "Model": "deepseek/deepseek-chat-v3.1",
  "EmbeddingModel": "openai/text-embedding-3-small",
  "TimeoutSeconds": 20,
  "MaxTokens": 256,
  "Temperature": 0.2,
  "EmbeddingCandidatePool": 100,
  "Referer": "http://localhost:5005",
  "Title": "PriceCompare"
},
 
  "AllowedHosts": "*"
}
