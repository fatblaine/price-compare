# ==================================================
# OPTIMIZED .GITIGNORE FOR PriceComparePlatform
# Base: dotnet new gitignore
# Enhanced for: ASP.NET Core, SQL Server, React, and Security
# ==================================================


# ==================================================
# 1. PROJECT-SPECIFIC & SECURITY CRITICAL IGNORES
# ==================================================
# DO NOT COMMIT SENSITIVE CONFIG FILES!
# appsettings.json is for shared, non-sensitive settings.
# Development configs with connection strings, keys, etc. must be ignored.
appsettings.*.json # <-- IGNORES ALL environment-specific files (e.g., appsettings.Production.json)
appsettings.Development.json # <-- Explicitly ignore dev config (DO NOT COMMIT SECRETS HERE)
appsecrets.json
appsecrets.*.json
*.env.local
*.env.development.local

# Local DB files (if you ever use LocalDB or SQL Express files)
*.mdf
*.ldf
*.ndf

# ==================================================
# 2. FRONTEND (React) IGNORES
# ==================================================
# Ignore Node.js dependencies and build outputs
# These are in the `client/` directory but the pattern applies to any node_modules
client/node_modules/
client/dist/
client/build/
client/.parcel-cache/
client/.eslintcache

# ==================================================
# 3. .NET & VISUAL STUDIO CORE IGNORES (from template)
# ==================================================
# User-specific files
*.suo
*.user
*.userosscache
*.sln.docstates
*.csproj.user

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/ # <-- Added for any custom log folders

# Visual Studio cache/options directory
.vs/

# MSTest test Results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*

# NUnit
*.VisualState.xml
TestResult.xml
nunit-*.xml

# .NET Core
project.lock.json
project.fragment.lock.json
artifacts/
**/publish/ # <-- Ignore publish outputs anywhere in the project

# Tye
.tye/

# Files built by Visual Studio
*.pdb
*.ipdb
*.iobj
*.tlb
*.tmp
*.tmp_proj
*.log
*.tlog
*.vspscc
*.vssscc
.builds
*.pidb
*.svclog
*.scc

# NuGet Packages
*.nupkg
*.snupkg
# The packages folder can be ignored because of Package Restore
**/[Pp]ackages/*
# except build/, which is used as an MSBuild target.
!**/[Pp]ackages/build/

# NuGet v3's project.json files produces more ignorable files
*.nuget.props
*.nuget.targets

# Microsoft Azure Build Output
csx/
*.build.csdef

# Others
*~
*.dbmdl
*.dbproj.schemaview
*.pfx
*.publishsettings
orleans.codegen.cs

# Backup & report files from converting an old project file
_UpgradeReport_Files/
Backup*/
UpgradeLog*.XML
UpgradeLog*.htm
ServiceFabricBackup/
*.rptproj.bak

# SQL Server files (reiterated for clarity)
*.mdf
*.ldf
*.ndf

# MFractors (Xamarin productivity tool) working folder
.mfractor/

# Local History for Visual Studio
.localhistory/

# Visual Studio History (VSHistory) files
.vshistory/

# ==================================================
# 4. IDE & EDITOR DIRECTORIES
# ==================================================
# JetBrains Rider
.idea/
*.sln.iml

# VS Code (but allow shared settings)
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# ==================================================
# 5. OS GENERATED FILES
# ==================================================
# Windows
Thumbs.db
ehthumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride
.Spotlight-V100
.Trashes

# ==================================================
# 6. EXPLICIT EXCEPTIONS (Important! KEEP THESE)
# ==================================================
# !!! PLEASE READ !!!
# Ensure critical files are NOT ignored, even if they match a pattern above.

# DO NOT ignore the main appsettings.json (only ignore environment-specific ones)
!appsettings.json

# DO NOT ignore solution/project files
!*.sln
!**/*.csproj

# DO NOT ignore NuGet config files
!nuget.config
!**/*.config

# DO NOT ignore README and Git related files
!README.md
!README
!.gitignore
!.gitattributes
.fake